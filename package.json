{
  "name": "cs2-ai-coach",
  "version": "0.1.0",
  "private": true,
  "description": "CS2 AI COACH — Telegram Mini App that connects FACEIT, detects matches, analyzes available data and provides adaptive tactical coaching with Groq AI.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "bot"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "migrate": "tsx packages/database/src/migrate.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:bot": "tsx watch bot/src/bot.ts",
    "dev:web": "npm run dev --workspace @cs2coach/web",
    "build:web": "npm run build --workspace @cs2coach/web && npm run typecheck --workspace @cs2coach/web",
    "start": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  }
}
