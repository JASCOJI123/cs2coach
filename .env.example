# ── CS2 AI COACH ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MS=604800000
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
TELEGRAM_WEBAPP_URL=https://your-frontend.onrender.com
TELEGRAM_WEBHOOK_URL=https://your-api.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
FACEIT_API_KEY=your-faceit-api-key
FACEIT_CLIENT_ID=your-faceit-client-id
FACEIT_CLIENT_SECRET=your-faceit-client-secret
FACEIT_REDIRECT_URI=https://your-api.onrender.com/api/auth/faceit/callback
FACEIT_AUTH_BASE_URL=https://api.faceit.com
FACEIT_AUTHORIZE_BASE_URL=https://accounts.faceit.com
FACEIT_DATA_BASE_URL=https://open.faceit.com/data/v4
# Shared value configured in FACEIT App Studio Webhooks callback authentication.
FACEIT_WEBHOOK_SECRET=
# Shared value placed inside the CS2 GSI config auth.token field.
CS2_GSI_TOKEN=
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
DEMO_MODE=false
FACEIT_POLL_INTERVAL_MS=45000
