# ── CS2 AI COACH ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- Core ----
NODE_ENV=development
PORT=8080
# Comma-separated origins allowed for CORS (Telegram Mini App + local dev).
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
# Secret used to sign session tokens issued after Telegram initData validation.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MS=604800000

# ---- Neon PostgreSQL (free tier) ----
# Format: postgres://user:password@host:port/db?sslmode=require
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# Public URL the frontend is served from (used by the bot's OPEN AI COACH button).
TELEGRAM_WEBAPP_URL=https://your-frontend.onrender.com
# Optional: set to make the bot run in webhook mode. Leave empty for polling.
TELEGRAM_WEBHOOK_URL=https://your-api.onrender.com/telegram/webhook
# Optional: secret telegram bot sets as webhook token (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# ---- FACEIT ----
FACEIT_API_KEY=your-faceit-api-key
FACEIT_CLIENT_ID=your-faceit-client-id
FACEIT_CLIENT_SECRET=your-faceit-client-secret
FACEIT_REDIRECT_URI=https://your-api.onrender.com/api/faceit/connect/callback
FACEIT_AUTH_BASE_URL=https://api.faceit.com
FACEIT_DATA_BASE_URL=https://open.faceit.com/data/v4
# Optional secret for FACEIT webhook verification (x-hub-signature / shared secret).
FACEIT_WEBHOOK_SECRET=

# ---- Groq (free tier) ----
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Demo / behavior ----
# Only true in local development. Production must set DEMO_MODE=false.
# Demo mode is allowed to synthesize sample events; it is never used in production.
DEMO_MODE=false
# Polling interval (ms) used to refresh FACEIT match status when webhooks are not configured.
FACEIT_POLL_INTERVAL_MS=45000